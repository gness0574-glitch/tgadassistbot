# Get API_ID and API_HASH from https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=your_api_hash_here
# Get BOT_TOKEN from @BotFather
BOT_TOKEN=123456:your_bot_token_here
# Optional tuning
GROUP_SCAN_LIMIT=5000
CHANNEL_POST_LIMIT=100
# Optional: enables AI-written ad copy for /ads (otherwise simple templates are used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Needed on Railway: run generate_session.py locally once and paste the output here
USER_SESSION=
